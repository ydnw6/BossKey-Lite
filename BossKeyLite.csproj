<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BossKey-Lite</AssemblyName>
    <RootNamespace>MoyuBossKey</RootNamespace>
    <ApplicationIcon>src\app.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <!-- 程序集特性写在 src/BossKeyLite.cs 顶部，不让 SDK 再生成一份 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
